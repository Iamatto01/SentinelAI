[Unit]
Description=SentinelAI Pentest Platform
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kali
WorkingDirectory=/home/kali/SentinelAI
Environment="NODE_ENV=production"
Environment="PORT=5173"
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/kali/.nvm/versions/node/v20.18.0/bin:/home/kali/go/bin"
EnvironmentFile=-/home/kali/SentinelAI/.env

# Clean all ports before start
ExecStartPre=/bin/bash -c 'fuser -k 5000/tcp 2>/dev/null || true; fuser -k 5173/tcp 2>/dev/null || true; fuser -k 8888/tcp 2>/dev/null || true; fuser -k 55553/tcp 2>/dev/null || true; sleep 1'

# Start everything via a single script (systemd can only track ONE main process)
ExecStart=/bin/bash /home/kali/SentinelAI/resources/start-all.sh

Restart=always
RestartSec=15
TimeoutStartSec=180

# Cleanup on stop — kill all services
ExecStop=/bin/bash -c 'fuser -k 5000/tcp 2>/dev/null; fuser -k 5173/tcp 2>/dev/null; fuser -k 55553/tcp 2>/dev/null; pkill -f cloudflared 2>/dev/null; pkill -f msfrpcd 2>/dev/null; true'
ExecStopPost=/bin/sleep 2

[Install]
WantedBy=multi-user.target